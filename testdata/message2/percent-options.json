    },
    {
      "src": "{0.4275 :percent roundingMode=halfExpand}",
      "exp": "43%"
    },
    {
      "src": "{0.423 :percent roundingMode=halfExpand}",
      "exp": "42%"
    },
    {
      "src": "{0.425 :percent roundingMode=halfExpand}",
      "exp": "43%"
    },
    {
      "src": "{-0.4274 :percent roundingMode=halfExpand}",
      "exp": "-43%"
    },
    {
      "src": "{-0.425 :percent roundingMode=halfExpand}",
      "exp": "-43%"
    },
    {
      "src": "{-0.423 :percent roundingMode=halfExpand}",
      "exp": "-42%"
    },
    {
      "src": "{0.4274 :percent roundingMode=halfTrunc}",
