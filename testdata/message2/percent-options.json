    {
      "src": "{-0.423 :percent roundingMode=halfEven}",
      "exp": "-42%"
    },
    {
      "src": "{0.4275 :percent minimumSignificantDigits=3 maximumSignificantDigits=7}",
      "exp": "42.75%"
    },
    {
      "src": "{0.4275 :percent minimumSignificantDigits=2 maximumSignificantDigits=3 minimumFractionDigits=3}",
      "exp": "42.8%"
    },
    {
      "src": "{0.4275 :percent minimumSignificantDigits=2 maximumSignificantDigits=3 maximumFractionDigits=3 roundingPriority=morePrecision}",
      "exp": "42.75%"
    },
    {
      "src": "{0.4275 :percent minimumSignificantDigits=2 maximumSignificantDigits=3 maximumFractionDigits=3 roundingPriority=lessPrecision}",
      "exp": "42.8%"
