      "src": "{-0.423 :percent roundingMode=halfTrunc}",
      "exp": "-42%"
    },
    {
      "src": "{0.4274 :percent roundingMode=halfEven}",
      "exp": "43%"
    },
    {
      "src": "{0.425 :percent roundingMode=halfEven}",
      "exp": "42%"
    },
    {
      "src": "{0.423 :percent roundingMode=halfEven}",
      "exp": "42%"
    },
    {
      "src": "{-0.4274 :percent roundingMode=halfEven}",
      "exp": "-43%"
