{
  "scenario": "Resolution errors",
  "description": "Tests for unknown variables and functions",
  "defaultTestProperties": {
    "locale": "en-US"
  },
  "tests": [
    { "src": "{$oops}", "exp": "{$oops}", "expErrors": [{ "type": "unresolved-variable" }] },
    { "src": ".input {$x :number} {{{$x}}}", "exp": "{$x}", "expErrors": [{ "type": "unresolved-variable" }] },
    { "src": ".local $foo = {$bar} .local $f = {$foo :number} .match $f  one {{one}}  * {{other}}", "exp": "other", "expErrors": [{ "type": "unresolved-variable" }] },
    { "src": ".local $bar = {$none :number} .local $f = {$foo :string} .match $f  one {{one}}  * {{{$bar}}}", "exp": "{$none}", "expErrors": [{ "type": "unresolved-variable" }] },
    { "src": "The value is {horse :func}.", "exp": "The value is {|horse|}.", "expErrors": [{ "type": "unknown-function" }] }
  ]
}
